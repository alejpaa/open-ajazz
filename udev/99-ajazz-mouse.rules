# Reglas udev para periféricos AJAZZ APEX (Mouse y Base de Carga con Pantalla TFT)
# Copiar este archivo a /etc/udev/rules.d/99-ajazz-mouse.rules
# Luego recargar con:
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger

# AJAZZ AJ159 / AJ179 APEX (VID: 0x3151, PID: 0x5007)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3151", ATTRS{idProduct}=="5007", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="3151", ATTRS{idProduct}=="5007", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="3151", ATTRS{idProduct}=="5007", MODE="0666", TAG+="uaccess"
